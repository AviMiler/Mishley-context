{
  "manifest_version": 3,
  "name": "Mishley Code - Context Bank for Internal Chat",
  "version": "0.2.0",
  "description": "בנק קונטקסטים לצ'אט הפנימי - פאנל צף, טעינת רקע, פרויקטים",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Context Bank (Ctrl+Shift+L)"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["tokenizer.js", "config.js", "prompts.js", "storage.js", "inject.js", "push.js", "ui-styles.js", "ui-template.js", "ctx-meter.js", "ui-modals.js", "fs-handles.js", "document-handler.js", "dep-graph.js", "code-tree.js", "history-view.js", "chat-features.js", "msg-nav.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "פתח/סגור Context Bank"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon.png", "tokenizer/o200k_base.tiktoken"],
      "matches": ["*://*/*", "<all_urls>"]
    }
  ]
}
