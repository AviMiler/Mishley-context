{
  "manifest_version": 3,
  "name": "Mishley Code - Context Bank for Internal Chat",
  "version": "0.2.0",
  "description": "בנק קונטקסטים לצ'אט הפנימי - פאנל צף, טעינת רקע, סיכום שיחות",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Context Bank (Ctrl+Shift+L)"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["config.js", "storage.js", "inject.js", "push.js", "ui-styles.js", "ui-template.js", "content.js", "summarizer.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "פתח/סגור Context Bank"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon.png"],
      "matches": ["*://*/*", "<all_urls>"]
    }
  ]
}
